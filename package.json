{
  "name": "gibyeol",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev:frontend": "pnpm --filter @gibyeol/frontend dev",
    "build:frontend": "pnpm --filter @gibyeol/frontend build",
    "storybook": "pnpm --filter @gibyeol/frontend storybook",
    "build:storybook": "pnpm --filter @gibyeol/frontend build:storybook",
    "package:dothome": "pnpm --filter @gibyeol/frontend package:dothome",
    "lint:frontend": "pnpm --filter @gibyeol/frontend lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "verify": "./scripts/verify.sh"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
