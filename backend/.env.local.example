# 이 파일을 `backend/.env.local`로 복사한 뒤 로컬 개발에 필요한 값만 입력한다.
# `.env.local`은 Git에서 제외되며 실제 API key나 비밀값을 이 예시 파일에 넣지 않는다.
# 기본 개발값은 `backend/.env`에 있으므로 아래 항목은 실제 이메일 발송이 필요할 때만 사용한다.

# 기본은 실제 발송 비활성화. Resend를 사용할 때 `resend`로 변경
EMAIL_PROVIDER=null

# Resend Dashboard에서 발급한 Sending access API key
RESEND_API_KEY=

# Resend에서 인증을 마친 발신 도메인의 주소
EMAIL_FROM=no-reply@example.invalid

# 로컬에서 Resend webhook까지 검증할 때만 실제 signing secret 입력
# RESEND_WEBHOOK_SECRET=CHANGE_ME
