# 이 파일을 Git에서 제외된 staging의 `_gibyeol/.env.local`로 복사한 뒤 실제 운영값을 입력한다.
# 완성된 `.env.local`에는 DB 비밀번호와 암호 키가 포함되므로 커밋하거나 외부에 공유하지 않는다.
# `CHANGE_ME`가 하나라도 남아 있는 상태에서는 서버에 업로드하지 않는다.

# Symfony가 쿠키와 내부 token을 보호할 때 사용하는 application secret이다.
# 새 값 생성 예시: openssl rand -hex 32
APP_SECRET=CHANGE_ME

# 닷홈 관리 화면의 MySQL ID, 비밀번호, DB명을 차례로 입력한다.
# 비밀번호에 @, :, /, # 같은 문자가 있으면 URL encoding한 값을 사용한다.
# 닷홈 DB host가 localhost가 아니라면 안내받은 host로 교체한다.
DATABASE_URL="mysql://CHANGE_ME:CHANGE_ME@localhost/CHANGE_ME?serverVersion=8.4.0&charset=utf8mb4"

# 사용자가 접속하는 프론트엔드 origin이다. 경로와 마지막 슬래시를 넣지 않는다.
# SIWE domain 및 credentialed CORS 허용 origin과 정확히 일치해야 한다.
WEB_ORIGIN=https://www.gibyeol.kro.kr

# 닷홈에서 공개되는 백엔드 origin이다. `/api/v1` 경로와 마지막 슬래시를 넣지 않는다.
DEFAULT_URI=https://CHANGE_ME.dothome.co.kr

# staging은 Base Sepolia chain ID 84532를 사용한다. Mainnet 배포 시 8453으로 변경한다.
CHAIN_ID=84532

# SIWE 검증과 온체인 조회에 사용하는 서버 전용 RPC endpoint다.
# 운영에서는 공식 public RPC 대신 발급받은 primary RPC를 권장하며 서로 다른 provider의 fallback을 둔다.
# URL에 API key가 포함될 수 있으므로 공개하거나 프론트엔드 환경변수에 재사용하지 않는다.
BASE_RPC_URL=https://sepolia.base.org
BASE_RPC_FALLBACK_URL=

# 이메일 주소를 DB에 암호화할 때 사용하는 32-byte key의 표준 Base64 값이다.
# 새 값 생성 예시: openssl rand -base64 32
EMAIL_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES

# 이메일 중복 조회용 HMAC key다. EMAIL_ENCRYPTION_KEY와 다른 값을 사용한다.
# 새 값 생성 예시: openssl rand -hex 32
EMAIL_LOOKUP_KEY=CHANGE_ME

# 이메일 인증번호를 저장하지 않고 검증하기 위한 HMAC key다. 다른 key와 분리한다.
# 새 값 생성 예시: openssl rand -hex 32
OTP_HMAC_KEY=CHANGE_ME

# 이메일 발송을 아직 연결하지 않았다면 null을 유지한다. Resend 연결 후 resend로 변경한다.
EMAIL_PROVIDER=null

# Resend dashboard에서 발급한 API key다. EMAIL_PROVIDER=null일 때는 빈 값으로 둘 수 있다.
RESEND_API_KEY=

# Resend webhook endpoint에 표시되는 signing secret 전체를 입력한다.
RESEND_WEBHOOK_SECRET=CHANGE_ME

# Resend에서 인증을 마친 발신 도메인의 주소를 사용한다.
EMAIL_FROM=no-reply@example.invalid

# 복구용 X25519 private key인 32-byte 난수의 표준 Base64 값이다.
# 새 값 생성 예시: openssl rand -base64 32
# 대응하는 public key를 contract 배포 인자에 사용하므로 먼저 offline backup과 대조 절차를 완료한다.
RECOVERY_PRIVATE_KEY=CHANGE_ME_BASE64_32_BYTES

# Base Sepolia에 배포한 Gibyeol2026 contract 주소다. 아직 배포 전이면 업로드를 보류한다.
GIBYEOL_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# 위 contract가 배포된 block number다. explorer 또는 배포 receipt에서 확인한다.
CONTRACT_DEPLOYMENT_BLOCK=0
